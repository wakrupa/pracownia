def silnia(n):
    wynik = 1
    for i in range (1, n + 1):
        wynik = wynik * i
    return wynik

def odmiana(k):
    if k == 1:
        return "cyfrę"
    elif 2 <= k % 10 <= 4 and not 12 <= k % 100 <= 14:
        return "cyfry"
    else:
        return "cyfr"

for n in range (0, 101):
    ilosc_cyfr = len(str(silnia(n)))
    print(str(n) + "! ma", ilosc_cyfr, odmiana(ilosc_cyfr))
