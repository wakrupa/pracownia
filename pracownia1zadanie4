def losuj_fragment():
     return choice(fragmenty)

def losuj_haslo(n):
    haslo = ""
    while len(haslo) < n:
        fragment = losuj_fragment()
        reszta = n - len(haslo) - len(fragment)
        if reszta == 0 or reszta >= 2:
            haslo += fragment
    return haslo

